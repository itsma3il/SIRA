# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sira
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/sira

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

# API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# AI Providers Configuration
# Provider selection: "mistral", "deepseek", "gemini"
LLM_PROVIDER=mistral
EMBEDDING_PROVIDER=mistral
EMBEDDING_DIMENSION=1024

# Mistral AI
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_EMBEDDING_MODEL=mistral-embed
MISTRAL_LLM_MODEL=mistral-large-latest

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_LLM_MODEL=deepseek-chat
DEEPSEEK_EMBEDDING_MODEL=deepseek-embed
# DEEPSEEK_EMBEDDING_BASE_URL=https://api.deepseek.com
# DEEPSEEK_EMBEDDING_DIMENSION=1536

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LLM_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=1024

# Pinecone Vector Database
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=sira-academic-programs

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5

# Environment
ENVIRONMENT=development
